import numpy as np
import faiss


def retrieve(
    query,
    model,
    index,
    chunks,
    top_k=5
):

    query_embedding = model.encode(
        [query]
    )

    query_embedding = np.array(
        query_embedding
    ).astype("float32")

    faiss.normalize_L2(
        query_embedding
    )

    scores, indices = index.search(
        query_embedding,
        top_k
    )

    results = []

    for idx, score in zip(
        indices[0],
        scores[0]
    ):

        results.append({
            "text": chunks[idx]["text"],
            "source": chunks[idx]["source"],
            "page": chunks[idx]["page"],
            "score": float(score)
        })

    return results
